# انسخ هذا الملف إلى .env.local وضع قيم مشروع Supabase الخاص بك
# (Settings -> API). المفتاح anon عام بطبيعته؛ لا تضع هنا service_role أبدًا.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# رابط الموقع النهائي (لخريطة الموقع sitemap.xml)
SITE_URL=https://YOUR-DOMAIN.dz
